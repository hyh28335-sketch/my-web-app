# OpenRouter API 配置
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 默认使用的模型 (可以是内置模型ID或完整的OpenRouter模型slug)
# 内置模型示例: claude-3.5-sonnet, gpt-4o, gemini-pro
# OpenRouter完整slug示例: anthropic/claude-3.5-sonnet, openai/gpt-4o
# Nano Banana模型: google/gemini-2.5-flash-image
OPENROUTER_MODEL=google/gemini-2.5-flash-image

# 前端URL (用于OpenRouter的HTTP-Referer头)
FRONTEND_URL=http://localhost:3000

# Google OAuth 配置 (可选)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Flask 配置
SECRET_KEY=your_secret_key_here
FLASK_ENV=development

# 数据库配置 (可选，默认使用SQLite)
# DATABASE_URL=sqlite:///notes.db