# Next.js 前端环境变量配置

# API 基础URL (生产环境需要修改为实际的后端URL)
NEXT_PUBLIC_API_URL=http://localhost:5001

# 默认AI模型 (应与后端OPENROUTER_MODEL保持一致)
# 内置模型示例: claude-3.5-sonnet, gpt-4o, gemini-pro
# OpenRouter完整slug示例: anthropic/claude-3.5-sonnet, openai/gpt-4o
# Nano Banana模型: google/gemini-2.5-flash-image
NEXT_PUBLIC_DEFAULT_MODEL=google/gemini-2.5-flash-image

# Google OAuth 配置 (可选，用于用户认证)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# 应用配置
NEXT_PUBLIC_APP_NAME=智能记事本
NEXT_PUBLIC_APP_VERSION=1.0.0